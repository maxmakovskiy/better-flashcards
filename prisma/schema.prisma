// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  decks         Deck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// #### `Tag`
//
// tag(**name**, description)
model Tag {
  name String @id
  description String?

  decks DeckTag[]
}

// #### `Deck`
//
// deck(**deckId**, title, description, createdAt, updatedAt, userId)
//
// deck.userId NOT NULL <br />
// deck.userId references user.id
model Deck {
  deckId String @id @default(cuid())
  title String
  description String?

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags DeckTag[]
  flashcards Flashcard[]
  studySessions StudySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// #### `DeckTag`
//
// deckTag(**deckId, tagName**)
//
// deckTag.deckId references deck.deckId <br/>
// deckTag.tagName references tag.name
model DeckTag {
  deckId String
  tagName String
  // TODO: add onDelete
  deck Deck @relation(fields: [deckId], references: [deckId])
  tag Tag @relation(fields: [tagName], references: [name], onUpdate: Cascade)

  @@id([deckId, tagName])
}

// #### `Flashcard`
//
// flashcard(**flashcardNum, deckId**, frontText, backText, easeFactor, intervalDays, repetitionCount, nextReviewAt, lastReviewedAt, memoryStrength, createdAt, updatedAt)
//
// flashcard.deckId references deck.deckId
model Flashcard {
  flashcardNum Int
  deckId String
  frontText String
  backText String
  easeFactor Float @default(2.5)
  intervalDays Int @default(0)
  repetitionCount Int @default(0)
  nextReviewAt DateTime @default(now())
  lastReviewAt DateTime?
  memoryStrength Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deck Deck @relation(fields: [deckId], references: [deckId])

  reviews ReviewHistory[]

  @@id([flashcardNum, deckId])
}

// #### `StudySession`
//
// studySession(**sessionId**, startedAt, endedAt, totalReviews, correctAnswers, avgResponseTimeMs, deckId)
//
// studySession.deckId NOT NULL <br />
// studySession.deckId references deck.deckId
model StudySession {
  sessionId String @id @default(cuid())
  startedAt DateTime @default(now())
  endedAt DateTime?
  totalReviews Int @default(0)
  correctAnswers Int @default(0)
  avgResponseTimeMs Int?
  deckId String
  deck Deck @relation(fields: [deckId], references: [deckId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedCards ReviewHistory[]
}

// #### `ReviewHistory`
//
// reviewHistory(**sessionId, flashcardNum, deckId,** difficultyRating, responseTimeMs, isCorrect, reviewedAt)
//
// reviewHistory.sessionId refences studySession.sessionId <br/>
// reviewHistory.flashcardNum refences flashcard.flashcardNum <br/>
// reviewHistory.deckId refences flashcard.deckId

// Taken from: https://www.npmjs.com/package/supermemo
// Grade description:
// 5: perfect response.
// 4: correct response after a hesitation.
// 3: correct response recalled with serious difficulty.
// 2: incorrect response; where the correct one seemed easy to recall.
// 1: incorrect response; the correct one remembered.
// 0: complete blackout.
enum DifficultyRatingEnum {
  AGAIN
  INCORRECT_REMEMBERED
  INCORRECT_EASY_RECALL
  CORRECT_BIG_HESITATION
  CORRECT_LITTLE_HESITATION
  PERFECT
}

model ReviewHistory {
  sessionId String
  flashcardNum Int
  deckId String

  session StudySession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardNum, deckId], references: [flashcardNum, deckId], onDelete: Cascade)

  difficultyRating DifficultyRatingEnum
  responseTimeMs Int
  isCorrect Boolean
  reviewedAt DateTime

  @@id([sessionId, flashcardNum, deckId])
}


